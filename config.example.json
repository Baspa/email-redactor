{
  "default_locale": "en",
  "keep_domains": ["basworld.com"],
  "keep_terms": ["BAS World", "BAS Trucks", "DAF", "Mercedes", "Volvo", "Actros", "Scania", "MAN"],
  "custom_patterns": [
    {"name": "bas_stock_number", "regex": "(?i)(?<=stocknummer )\\d{6}|(?<=/)\\d{6}(?=[?#\\s]|$)", "strategy": "keep"},
    {"name": "vin", "regex": "\\b[A-HJ-NPR-Z0-9]{17}\\b", "strategy": "alnum", "keep": 11},
    {"name": "nl_plate", "regex": "\\b[A-Z0-9]{1,3}-[A-Z0-9]{2,3}-[A-Z0-9]{1,2}\\b", "strategy": "alnum"}
  ]
}
